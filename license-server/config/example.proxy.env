# License server behind a TLS reverse proxy (nginx, Caddy) on the same
# machine. The proxy must set X-Forwarded-For and X-Forwarded-Proto.
LMP_SIGNING_KID=prod-2026-10
LMP_ADMIN_ALLOWED_IPS=203.0.113.10
LMP_TLS_MODE=proxy
LMP_LISTEN_HOST=127.0.0.1
LMP_PORT=8443
LMP_TRUSTED_PROXIES=127.0.0.1,::1
LMP_DATA_DIR=/var/lib/lmp
LMP_KEYS_DIR=/etc/lmp/keys
LMP_SECRETS_DIR=/etc/lmp/secrets
LMP_BACKUP_DIR=/var/backups/lmp
LMP_LOG_LEVEL=info
