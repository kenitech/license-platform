# License server settings for a server that terminates HTTPS itself with a
# Let's Encrypt certificate. Copy to /etc/lmp/license-server.env and edit.

# Name of the signing key created with "node bin/keys.js generate <name>".
LMP_SIGNING_KID=prod-2026-10

# Only these addresses may use the admin API: the IP address of your EspoCRM
# server. Separate several with commas. IPv4 ranges like 10.0.0.0/24 work.
LMP_ADMIN_ALLOWED_IPS=203.0.113.10

# HTTPS on port 443 with the certificate the renewal hook copies here.
LMP_TLS_MODE=direct
LMP_LISTEN_HOST=0.0.0.0
LMP_PORT=443
LMP_TLS_CERT_FILE=/etc/lmp/tls/fullchain.pem
LMP_TLS_KEY_FILE=/etc/lmp/tls/privkey.pem

# Where things live (these are the defaults).
LMP_DATA_DIR=/var/lib/lmp
LMP_KEYS_DIR=/etc/lmp/keys
LMP_SECRETS_DIR=/etc/lmp/secrets
LMP_BACKUP_DIR=/var/backups/lmp
# Hourly backups to keep (168 = one week).
LMP_BACKUP_KEEP=168

# Protection against key guessing: failed activations allowed per address
# within the window before the address is refused for a while.
LMP_ACTIVATION_FAILURE_LIMIT=10
LMP_ACTIVATION_FAILURE_WINDOW_SECONDS=600
LMP_PUBLIC_RATE_LIMIT_PER_MINUTE=120

# debug, info, warn or error
LMP_LOG_LEVEL=info
