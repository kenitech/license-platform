{
    "fields": {
        "name": {
            "type": "varchar",
            "readOnly": true,
            "maxLength": 255
        },
        "order": {
            "type": "link",
            "required": true
        },
        "plan": {
            "type": "link",
            "required": true
        },
        "quantity": {
            "type": "int",
            "min": 1,
            "max": 1000,
            "default": 1,
            "required": true
        },
        "unitPrice": {
            "type": "currency",
            "min": 0,
            "tooltip": true
        },
        "amount": {
            "type": "currency",
            "readOnly": true
        },
        "issuedCount": {
            "type": "int",
            "readOnly": true,
            "default": 0
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "order": {
            "type": "belongsTo",
            "entity": "LmLicenseOrder",
            "foreign": "items"
        },
        "plan": {
            "type": "belongsTo",
            "entity": "LmLicensePlan",
            "foreign": "orderItems"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "asc"
    }
}
