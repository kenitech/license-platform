{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "maxLength": 100,
            "tooltip": true
        },
        "account": {
            "type": "link",
            "required": true
        },
        "contact": {
            "type": "link"
        },
        "orderDate": {
            "type": "date",
            "required": true,
            "default": "javascript: return this.dateTime.getToday();"
        },
        "salesChannel": {
            "type": "enum",
            "options": [
                "Direct",
                "Website",
                "Reseller",
                "Marketplace",
                "Other"
            ],
            "default": "Direct"
        },
        "amount": {
            "type": "currency",
            "readOnly": true
        },
        "paymentStatus": {
            "type": "enum",
            "options": [
                "Pending",
                "Paid",
                "Refunded",
                "Failed"
            ],
            "default": "Pending",
            "style": {
                "Paid": "success",
                "Refunded": "warning",
                "Failed": "danger"
            }
        },
        "administrativeApproval": {
            "type": "enum",
            "options": [
                "None",
                "Approved",
                "Rejected"
            ],
            "default": "None",
            "tooltip": true,
            "style": {
                "Approved": "success",
                "Rejected": "danger"
            }
        },
        "issuanceStatus": {
            "type": "enum",
            "options": [
                "Not Issued",
                "Partially Issued",
                "Issued"
            ],
            "default": "Not Issued",
            "readOnly": true,
            "style": {
                "Issued": "success",
                "Partially Issued": "warning"
            }
        },
        "assignedUser": {
            "type": "link",
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        }
    },
    "links": {
        "account": {
            "type": "belongsTo",
            "entity": "Account",
            "foreign": "lmLicenseOrders"
        },
        "contact": {
            "type": "belongsTo",
            "entity": "Contact"
        },
        "items": {
            "type": "hasMany",
            "entity": "LmOrderItem",
            "foreign": "order"
        },
        "licenses": {
            "type": "hasMany",
            "entity": "LmLicense",
            "foreign": "order"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "collection": {
        "orderBy": "orderDate",
        "order": "desc",
        "textFilterFields": [
            "name",
            "accountName"
        ]
    },
    "indexes": {
        "name": {
            "unique": true,
            "columns": [
                "name",
                "deleted"
            ]
        }
    }
}
